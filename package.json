{
  "name": "elevate-realty",
  "version": "1.0.0",
  "description": "Luxury real estate platform with advanced property search, market analytics, and user management",
  "main": "index.html",
  "type": "module",
  "keywords": [
    "real-estate",
    "luxury",
    "property",
    "tailwind",
    "javascript",
    "responsive"
  ],
  "author": "Elevate Realty Team",
  "license": "MIT",
  "homepage": "https://elevaterealty.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/elevate-realty/platform.git"
  },
  "dependencies": {
    "@dhiwise/component-tagger": "^1.0.5",
    "@tailwindcss/forms": "^0.5.7",
    "axios": "^1.6.2",
    "firebase": "^10.7.1",
    "jwt-decode": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-elevation": "^2.0.0",
    "tailwindcss-fluid-type": "^2.0.7",
    "web-vitals": "^3.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.2",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/line-clamp": "^0.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^9.1.7",
    "postcss": "^8.5.5",
    "postcss-cli": "^10.1.0",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^10.2.3",
    "prettier": "^3.0.3",
    "tailwindcss": "^4.1.10",
    "vite": "^5.0.0",
    "vite-plugin-full-reload": "^1.0.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "prepare": "husky install",
    "build:css": "npx @dhiwise/component-tagger && npx tailwindcss -i ./css/tailwind.css -o ./css/main.css --minify",
    "watch:css": "npx @dhiwise/component-tagger && npx tailwindcss -i ./css/tailwind.css -o ./css/main.css --watch",
    "serve": "vite preview --port 8000",
    "serve:dev": "concurrently \"npm run watch:css\" \"vite\"",
    "lint:css": "npx tailwindcss -i ./css/tailwind.css -o ./css/main.css --watch --verbose",
    "clean": "rm -rf ./dist ./css/main.css",
    "update-deps": "npm update && npm audit fix"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:prettier/recommended"
    ],
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-console": "warn",
      "no-debugger": "warn"
    }
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "avoid"
  }
}
